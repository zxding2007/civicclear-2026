# Optional analysis only. Saved examples and the calculator need no API key.
# Choose deepseek or anthropic. Never commit a populated .env file.
CIVICCLEAR_PROVIDER=deepseek
DEEPSEEK_API_KEY=
CIVICCLEAR_ANALYST_PASSWORD=

# To use Claude instead, set CIVICCLEAR_PROVIDER=anthropic and fill this key:
# ANTHROPIC_API_KEY=

# Optional model override. Omit it to use the selected provider's default:
# DeepSeek: deepseek-flash; Anthropic: claude-opus-5-5.
# Remove or replace an old override whenever you switch provider.
# CIVICCLEAR_MODEL=

# If CIVICCLEAR_PROVIDER is unset, DeepSeek is selected only when its key is
# present and ANTHROPIC_API_KEY is absent; otherwise Anthropic is selected.
